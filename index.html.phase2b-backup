  .batch-progress { display: flex; align-items: center; gap: 12px; margin-bottom: 4px; }
  .progress-bar { flex: 1; height: 6px; background: var(--track); border-radius: 999px; overflow: hidden; }
  .progress-fill { height: 100%; width: 0%; background: var(--blue-600); border-radius: 999px; transition: width .2s ease; }
  .progress-text { font-size: .875rem; font-weight: 600; color: var(--ink-600); white-space: nowrap; }
  .batch-list { list-style: none; margin: 16px 0 0; display: grid; gap: 8px; max-height: 340px; overflow: auto; }
  .batch-item { display: flex; align-items: center; gap: 12px; padding: 10px 14px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); }
  .bi-name { flex: 1 1 auto; min-width: 0; font-weight: 600; font-size: .9rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .bi-sizes { font-size: .8125rem; color: var(--ink-600); white-space: nowrap; }
  .bi-orig { color: var(--ink-400); }
  .bi-comp { font-weight: 700; color: var(--green-600); }
  .bi-status { font-size: .78rem; font-weight: 600; color: var(--ink-400); min-width: 4em; text-align: right; }
  .bi-status.done { color: var(--green-600); }
  .bi-status.error { color: var(--red-600); }

  /* Before / after */
  .compare { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 24px; }
  .preview { margin: 0; }
  .preview figcaption { font-size: .875rem; font-weight: 600; color: var(--ink-600); margin-bottom: 8px; }
  .preview-box {
    aspect-ratio: 1 / 1; width: 100%; max-width: 400px;
    background: #f1f5f9;
    border: 1px solid var(--line); border-radius: 10px;
    display: flex; align-items: center; justify-content: center; overflow: hidden;
