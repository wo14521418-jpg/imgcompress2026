  .level-btn:hover { border-color: var(--blue-600); }
  .level-btn:focus-visible { outline: 2px solid var(--blue-600); outline-offset: 2px; }
  .level-btn.active { background: var(--blue-600); border-color: var(--blue-600); }
  .level-name { font-weight: 700; font-size: .9rem; color: var(--ink-900); }
  .level-q { font-size: .75rem; color: var(--ink-400); }
