  .content-block h2 { font-size: 1.25rem; font-weight: 700; letter-spacing: -0.01em; margin-bottom: 14px; }
  .content-block p { color: var(--ink-600); line-height: 1.8; margin: 0 0 14px; }
  .content-block p:last-child { margin-bottom: 0; }
  .content-block strong { color: var(--ink-900); }
  .content-block ol, .content-block ul { margin: 0 0 0 1.1em; display: grid; gap: 10px; }
  .content-block li { padding-left: 4px; }
  .content-block li::marker { color: var(--blue-600); font-weight: 700; }
  .faq-item { padding: 14px 0; border-top: 1px solid var(--line); }
  .faq-item:first-child { border-top: none; }
  .faq-item h4 { font-size: 1rem; font-weight: 700; }
  .faq-item p { margin-top: 6px; color: var(--ink-600); font-size: .95rem; }

  /* ---------- Footer ---------- */
  .site-footer { background: var(--white); border-top: 1px solid var(--line); margin-top: 48px; padding: 28px 0 32px; }
  .footer-inner { display: flex; flex-direction: column; align-items: center; gap: 18px; text-align: center; }
  .ad-slot {
    width: 100%; max-width: 728px; min-height: 90px;
  }
  .footer-nav { display: flex; flex-wrap: wrap; gap: 8px 22px; justify-content: center; }
  .footer-nav a { color: var(--ink-600); text-decoration: none; font-size: .875rem; }
  .footer-nav a:hover { color: var(--blue-600); }
  .copyright { color: var(--ink-400); font-size: .8125rem; }

  /* ---------- Cookie banner ---------- */
  .cookie-banner {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 40;
    background: var(--white); border-top: 1px solid var(--line);
    box-shadow: 0 -8px 24px rgba(15, 23, 42, .08);
    padding: 16px 20px;
  }
  .cookie-inner { max-width: 880px; margin: 0 auto; display: flex; flex-wrap: wrap; align-items: center; gap: 14px; }
  .cookie-inner p { flex: 1 1 280px; font-size: .9rem; color: var(--ink-600); }
  .cookie-actions { display: flex; gap: 10px; }
  .cookie-actions .btn { padding: 9px 18px; font-size: .9rem; }

  /* ---------- Responsive ---------- */
  @media (max-width: 560px) {
    .compare { grid-template-columns: 1fr; }
    .cookie-actions { width: 100%; justify-content: flex-end; }
  }

  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; animation: none !important; }
    html { scroll-behavior: auto; }
  }
</style>
