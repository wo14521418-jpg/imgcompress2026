  .fi-label { font-size: .78rem; color: var(--ink-600); }
  .fi-value { font-weight: 600; font-size: .95rem; overflow-wrap: anywhere; }

  /* Compression level */
  .level-row { margin-top: 24px; }
  .level-label { display: block; font-weight: 600; margin-bottom: 8px; }
  .level-options { display: flex; flex-wrap: wrap; gap: 8px; }
