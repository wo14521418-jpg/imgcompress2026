  .preview-box img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .preview-empty { color: var(--ink-400); font-size: .85rem; padding: 0 12px; text-align: center; }
  .preview-meta { display: block; margin-top: 6px; font-size: .8125rem; color: var(--ink-400); text-align: center; }

  /* Stats */
  .stats { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 20px; }
  .stat {
    flex: 1 1 130px; background: var(--bg); border: 1px solid var(--line);
    border-radius: 10px; padding: 14px 16px;
